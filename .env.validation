# 验证专用配置（.env.validation）
#
# 用途：任何"这个策略能不能赚钱"的结论，必须用这份配置跑出来的数据支撑。
# .env 是【演示配置】——它明知故犯地关闭了所有安全闸门（见 .env 内注释），
# 目的是让模拟器把完整链路跑起来以便观察，不是为了赚钱。
# 用 .env 跑出来的净值不能用来判断策略有效性。
#
# 用法：
#   set -a; . ./.env.validation; set +a; python -m app.main
# 或在代码里显式加载，不要依赖环境默认值。
#
# ---- 为什么需要单独一份 ----
# 2026-09-14 的审查发现：最近一次模拟的每一笔交易都带 reason code
# "edge_gate_disabled"，因为 .env 里 SYMBOL_EDGE_ENABLED=0 且
# SYMBOL_EDGE_MIN_NET_BPS=-999。而当时 6 个在选品种的已实现净边缘【全部为负】
# （均值 -11.13 bp，最好 -6.04，最差 -18.26）。也就是说：
# 闸门本来会挡住全部 6 个品种，但被配置成了永远不会触发。

# ---- 模型层：要求正期望 ----
# |预测| 必须 >= 该值才考虑开仓。0.5bp 仍低于 12bp 往返成本，
# 真正的成本约束由 MIN_EDGE_MULTIPLE 承担。
MODEL_MIN_EDGE_BPS=0.5
# 三个模型的方向一致率下限。0.3 等于允许 1/3，接近随机。
MODEL_MIN_AGREEMENT=0.6
MODEL_RULE_FALLBACK=0
# 特征越界时拒绝，而不是仅告警。
MODEL_OOD_POLICY=block

# ---- 品种证据层（meta-labeling）：这是本次被关掉的那道闸 ----
# 1 = 启用。品种必须用自己的已实现扣费后战绩证明值得交易。
SYMBOL_EDGE_ENABLED=1
SYMBOL_EDGE_HORIZON_BARS=3
SYMBOL_EDGE_WINDOW=200
SYMBOL_EDGE_MIN_SAMPLES=30
# 要求已实现净边缘【严格为正】。恢复 0 即"只交易历史证明赚钱的品种"。
SYMBOL_EDGE_MIN_NET_BPS=0
# 样本不足时拒绝（deny until proven）。观测照常记录，被拒品种可挣回资格。
SYMBOL_EDGE_REQUIRE_SAMPLES=1
# 均值必须超过 min_t 个标准误。0 会退化成"只看 30 样本均值的符号"。
SYMBOL_EDGE_MIN_T=2.0
# 跨品种多重检验校正。0 = 关闭。建议 >0。
SYMBOL_EDGE_FDR=0.0
SYMBOL_EDGE_EXPLORE_SLOTS=1

# ---- 目标距离层 ----
# 目标距离必须覆盖往返成本的倍数。1.0 在接近抛硬币的信号上等于全部放行。
MIN_EDGE_MULTIPLE=2.5

# ---- 风险层 ----
RISK_PROFILE=balanced

# ---- 开跑前必须检查 ----
# 下面这些是"演示开关"。若其中任何一个处于演示值，本次运行的净值
# 就不能用来判断策略有效性：
#   MODEL_MIN_EDGE_BPS < 0.5
#   MODEL_MIN_AGREEMENT < 0.6
#   SYMBOL_EDGE_ENABLED = 0
#   SYMBOL_EDGE_MIN_NET_BPS < 0
#   MODEL_OOD_POLICY = warn
#   MIN_EDGE_MULTIPLE < 2.5
