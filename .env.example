# 市场数据站点。binancefuture.com 是测试网：实测同一时间窗口内更新数 129 条 vs 10645 条，中位买卖价差 0.54bps vs 0.01bps，且买一侧挂单 0.002 BTC 而卖一侧 353.8 BTC。与 BINANCE_BASE_URL 的生产站点混用会让特征、K 线与成交模拟全部来自测试网。
# 启动时会自动做一次一致性校验（VENUE_CHECK_POLICY=warn|block|off）。
TRADING_MODE=paper
BINANCE_BASE_URL=https://fapi.binance.com
# Swap the websocket host when fstream.binance.com is unreachable on your network.
# BINANCE_WS_URL=wss://fstream.binance.com
SYMBOLS=BTCUSDT,ETHUSDT
INTERVAL=5m
LOOKBACK=250
POLL_SECONDS=60
STARTING_EQUITY=10000
# Aggressiveness is a named profile, not a startup constant, so it can be changed at
# runtime without editing this file or restarting:
#   GET  /api/risk/profiles   every preset plus the parameters currently in force
#   POST /api/risk/profile    {"profile": "assertive"}
#   POST /api/risk/profile    {"profile": "balanced", "overrides": {"max_risk_per_trade": 0.02}}
# Presets: conservative, balanced, assertive, aggressive, maximum. Each sets every
# sizing parameter together so they stay coherent: max_portfolio_risk always covers the
# per-trade risks it permits, and the symbol cap never exceeds the gross cap.
RISK_PROFILE=balanced
# The MAX_* values below are fallbacks, used only when no profile is set.
MAX_RISK_PER_TRADE=0.005
MAX_PORTFOLIO_RISK=0.02
TARGET_EXPOSURE=2.0
MAX_DAILY_LOSS=0.20
# The edge, in bps, at which a signal earns the full per-trade risk budget. Below it the
# budget scales linearly to zero at break-even, so a marginal signal that barely clears
# the cost floor no longer trades the same size as the best one. 0 disables edge scaling
# and sizes every accepted signal identically, which is the pre-audit behaviour.
SIZING_REFERENCE_EDGE_BPS=25.0
# Portfolio caps, both multiples of equity rather than absolute amounts. The old
# MAX_NOTIONAL_MULTIPLE silently overrode the session's leverage, and absolute
# MAX_*_NOTIONAL values could not mean the same thing on a 100 and a 10000 account.
MAX_POSITIONS=4
MAX_SYMBOL_LEVERAGE=3
MAX_GROSS_LEVERAGE=5
DATA_DIR=data
# 执行卫生：入场计划只对应一根 K 线，挂单超过该窗口即撤单，
# 避免几小时后按陈旧计划成交（止损/止盈仍停留在旧价位）。
ORDER_TTL_MS=90000
# 行情已走完止损的该比例（逆行）或止盈的该比例（顺行）时放弃入场。
MAX_ENTRY_ADVERSE_FRACTION=0.5
MAX_ENTRY_CHASE_FRACTION=0.35
# 任意成交（含延迟成交）后该标的的静默期。
ENTRY_COOLDOWN_MINUTES=5
MARKET_GUARD_MAX_AGE_MS=120000

# 审计保留：按行数而非天数。events 表曾有 107 万行却只覆盖 0.92 天，
# 其中 75.8 万行是 strategy_decision，每 5000 行只对应 32 个不同决策（156 倍冗余）。
# 数据量随 tick 频率而非时间增长，所以只有行窗口才能真正约束查询成本。
# 老于该行数的记录会先复制进 events_archive 再删除，不会丢失。
# 成交/爆仓/会话生命周期事件不受行数限制，始终留在热表。
EVENT_RETENTION_ROWS=50000
EVENT_RETENTION_INTERVAL_SECONDS=900
# 行情原始事件审计采样间隔。
MARKET_EVENT_AUDIT_MS=1000

# 模拟交易决策全部由真实已训练模型产生
MODEL_DEVICE=cpu
MODEL_CHRONOS_ENABLED=1
MODEL_CHRONOS_HORIZON=15
MODEL_MAX_CHRONOS_SYMBOLS=8
MODEL_MIN_EDGE_BPS=0.5
MODEL_MIN_AGREEMENT=0.6
MODEL_RULE_FALLBACK=0
MODEL_OOD_POLICY=block

# ---- 优势门槛与逐品种过滤（meta-labeling 层）----
# 模型方向命中率实测约 50%，但品种间差异极大：同一时期有的品种 15 分钟命中 64%，
# 有的只有 33%。此前所有品种用同样的规则和仓位交易，亏损品种由盈利品种补贴。
# 这一层让"主模型提出方向、第二层决定这次是否值得下手"。
SYMBOL_EDGE_ENABLED=1
# 用于评分的持有期（K 线根数）。实测优势在 6 根（30 分钟）附近最强。
SYMBOL_EDGE_HORIZON_BARS=3
# 每个品种保留的已结算观测数；太长会让已经失效的品种靠历史苟活。
SYMBOL_EDGE_WINDOW=200
# 达到多少条观测才允许交易。证据不足时默认拒绝（require_samples=1）。
SYMBOL_EDGE_MIN_SAMPLES=30
# 要求扣费后平均净收益高于此值（bps）。0 = 只要求为正。
SYMBOL_EDGE_MIN_NET_BPS=0
# 证据不足时拒绝。安全的前提是：无论是否允许交易，观测都会记录，
# 所以被拒的品种仍在积累证据，可以自己挣回交易资格。
SYMBOL_EDGE_REQUIRE_SAMPLES=1
# 目标距离必须覆盖往返成本的倍数。1.0 意味着只要勉强超过成本就放行，
# 在接近抛硬币的信号上等于全部放行；实测优势与 12bps 往返成本同量级。
MIN_EDGE_MULTIPLE=2.5
# 用实测的优势持续期自动对齐离场时间止损。实测最佳为 6 根（30 分钟），
# 而原几何瞄准的是数小时的持有。策略里已显式设置 time_stop_bars 时不覆盖。
EXIT_ALIGN_TO_MEASURED_HORIZON=1
# 为证据不足的品种保留的槽位。信号只为会话持有的品种计算，因此只选"已验证"的品种
# 会永远无法发现新品种，门槛会冻结在最初学到的那几个上。
SYMBOL_EDGE_EXPLORE_SLOTS=1

# ----------------------------------------------------------------------------
# 监控、漂移、重训与对账
# ----------------------------------------------------------------------------
# 标定价格用的标记价时效上界（毫秒）。资金费 8 小时结算一次，标记价取自
# derivatives_detail 的 5 分钟采集行（open_interest_value / open_interest 即该桶均价）；
# 超过此上界的标记价不能用于计算 mark_basis，该特征返回 None 并计入 degraded。
# 实测：用 8 小时前的标记价当基差，会让 9.711% 的训练行压在 ±2% 截断值上。
MAX_BASIS_AGE_MS=900000
# 特征漂移监控：对比训练集（蓄水池抽样）与最近窗口的 PSI。
DRIFT_CHECK_ENABLED=1
DRIFT_WINDOW=2000
DRIFT_INTERVAL_SECONDS=3600
DRIFT_PSI_THRESHOLD=0.2
# warn 只上报并进入 /health；block 会让漂移中的特征阻断新开仓。
DRIFT_POLICY=warn
# 监督式重训：按间隔检查漂移并在需要时重建候选。默认关闭，训练很贵。
RETRAIN_ENABLED=0
RETRAIN_INTERVAL_SECONDS=21600
# 只允许交易通过晋级门禁的权重。默认 0。实测：data/models 为空，
# ModelRegistry('data/models').current() 返回 None，服务实际跑的是
# data/research_v3/candidates 下的 LightGBM/CatBoost 候选（无校准器，
# 因此这些信号的 probability_up 是 None）。打开本开关会让服务直接停止开仓。
# 顺序：重建数据集 -> python -m app.advanced_model <dataset> --register
# -> 确认 /health 的 models 检查从 trading_unpromoted_weights 变成 tradable
# -> 再打开本开关。配合 MODEL_MAX_AGE_HOURS 一起用。
MODEL_REQUIRE_PROMOTED=0
# 权重的最大年龄（小时）。0 = 不检查。超龄权重会被判为 provenance 问题。
MODEL_MAX_AGE_HOURS=0
# 逐分钟成交额/强平聚合（真实数据，非测试网口径）。
FLOW_COLLECT_ENABLED=1
FLOW_DRAIN_SECONDS=30
FLOW_ARCHIVE_ROWS=2000000
# 账户三视图对账：成交台账推得的持仓 / 现金 / 挂单。只上报差异，不自动修正。
RECONCILE_ENABLED=1
RECONCILE_INTERVAL_SECONDS=300
# 撮合成本模型。此前 broker 硬编码 0.0400% taker + 2bp，任何一段历史 session 都
# 无法用它假定的成本来解释。IMPACT_BPS 默认 0 = 价格与下单量无关（改动前行为）。
TAKER_FEE_RATE=0.0004
MAKER_FEE_RATE=0.0002
SPREAD_BPS=2.0
IMPACT_BPS=0.0
# 订单到交易所的往返时间（毫秒）与「在途期间有多少比例的行情是逆向的」。
# 决策在 bar 收盘做出，成交不在那个价格 —— 0 延迟是最有利于回测、最不利于实盘的
# 假设。ENTRY_LATENCY_MS=0 即逐位回到旧行为。默认 350ms 是零售 HTTP 客户端的诚实取值。
ENTRY_LATENCY_MS=350
LATENCY_ADVERSE_SHARE=1.0

# ═══════════════════════════════════════════════════════════════════════════
# 以下为 2026-09-13 新增键。若你的 .env 是更早生成的，这里面可能缺这些项；
# 缺项不会报错（代码里有同样默认值），但显式列出更好排查。
# ═══════════════════════════════════════════════════════════════════════════

# ── 进场方式：挂单(maker) 还是 吃单(taker) ──────────────────────────────
# market = 吃单，立刻成交，往返 12bp（4bp taker 费率 ×2 + 2bp 价差 ×2）
# limit  = 挂单，往返 4bp（2bp maker 费率 ×2，不吃价差），
#          代价是只有市场走到你的价位才成交，未成交即错过。
# 这个开关同时决定成本模型：挂单时 gate 用 2×maker 计价，市价时用 2×taker+价差。
ENTRY_ORDER_TYPE=market
# 挂单挂在盘口的哪一侧。0 = 挂在近端（买单挂买一、卖单挂卖一）。
# 正数表示再多让这么多 bps，价格更好但更难成交。
ENTRY_PASSIVE_OFFSET_BPS=0

# ── 训练性能 ────────────────────────────────────────────────────────────
# 数据集构建的并行度（每品种一个进程）。0 = 自动 = min(品种数, 核数/2, 4)。
# 上限是内存决定的，不是核数：每个 worker 持有单个品种的蜡烛并在内存里构建行，
# 而服务同时持有上一阶段的整个数据集。16GB 内存上开到 12 个会让系统杀进程。
# 设 1 = 旧的串行行为（实测 8 品种 263.6 秒，并行 69.8 秒）。
MODEL_DATASET_WORKERS=0
# GBDT 线程数。0 = 自动（核数-2，上限 16）。原先硬编码为 2。
# 注意拟合本身很快（40 万行 ×150 轮约 0.8 秒），这里收益有限。
MODEL_THREADS=0
# GBDT 是否用 GPU。LightGBM 的 pip 轮子没有编译 GPU tree learner，
# 设成 gpu 会直接报错；CatBoost 支持。
MODEL_GBDT_DEVICE=cpu

# ── 特征降级是否阻断决策 ────────────────────────────────────────────────
# block = 任一特征被默认值填充就拒绝该决策；warn = 照常决策但写进原因码。
# 本机线上唯一被降级的是 7 个 flow_*/liquidation_* 特征，其数据源不存在
# （flow 表为空，Binance 归档无 liquidationSnapshot），且训练集里同样是常量 0。
FEATURE_DEGRADED_POLICY=block

# ── 网络代理 ────────────────────────────────────────────────────────────
# 【搬运时最需要注意的一项】
#
# 默认全部注释掉，也就是直连。只有在你所在网络【无法直连 Binance】时才需要打开。
# 实测例子：fapi.binance.com（REST）直连可用，但 fstream.binance.com（行情 WS）
# 直连 25 秒超时，必须走代理才 0.2 秒收到数据。
#
# 为什么不能只靠系统代理：aiohttp 的 trust_env=True 只读【环境变量】，
# 而 Windows 的“系统代理”在注册表里——curl 读得到，Python 读不到。
#
# 如果搬到没有该代理的机器上却留着这几行，【所有】网络请求都会失败。
# 先确认代理可用再打开，或者干脆留空让代码直连。
# BINANCE_WS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 行情 WebSocket 地址。默认生产端点；只有做对照实验时才改。
BINANCE_WS_URL=wss://fstream.binance.com
